{
    "name": "drei-d/laravel-sepa-xml",
    "description": "Creates SEPA XML files",
    "type": "library",
    "version": "2.0.0",
    "autoload": {
        "psr-4": {
            "DREID\\LaravelSepaXml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DREID\\LaravelSepaXml\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Oliver Vollborn"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "laravel/framework": "^10|^11|^12|^13"
    },
    "optional": {
        "ext-iconv": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "larastan/larastan": "^3.15",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "DREID\\LaravelSepaXml\\Providers\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
